{
  "name": "@supercalorie/ui",
  "version": "0.0.1",
  "private": true,
  "description": "superCalorie design system \u2014 shared tokens with platform-native components for React (web) and React Native (Expo).",
  "exports": {
    "./tokens": "./src/tokens.ts",
    "./theme": "./theme.cjs",
    "./tailwind-preset": "./tailwind-preset.cjs",
    "./activity-rings": {
      "react-native": "./src/activity-rings/ActivityRings.native.tsx",
      "types": "./src/activity-rings/ActivityRings.web.tsx",
      "default": "./src/activity-rings/ActivityRings.web.tsx"
    },
    "./bar-chart": {
      "react-native": "./src/bar-chart/BarChart.native.tsx",
      "types": "./src/bar-chart/BarChart.web.tsx",
      "default": "./src/bar-chart/BarChart.web.tsx"
    },
    "./heatmap": {
      "react-native": "./src/heatmap/Heatmap.native.tsx",
      "types": "./src/heatmap/Heatmap.web.tsx",
      "default": "./src/heatmap/Heatmap.web.tsx"
    },
    "./app-button": {
      "react-native": "./src/app-button/AppButton.native.tsx",
      "types": "./src/app-button/AppButton.web.tsx",
      "default": "./src/app-button/AppButton.web.tsx"
    },
    "./calorie-dial": {
      "react-native": "./src/calorie-dial/CalorieDial.native.tsx",
      "types": "./src/calorie-dial/CalorieDial.web.tsx",
      "default": "./src/calorie-dial/CalorieDial.web.tsx"
    },
    "./food-row": {
      "react-native": "./src/food-row/FoodRow.native.tsx",
      "types": "./src/food-row/FoodRow.web.tsx",
      "default": "./src/food-row/FoodRow.web.tsx"
    },
    "./section-heading": {
      "react-native": "./src/section-heading/SectionHeading.native.tsx",
      "types": "./src/section-heading/SectionHeading.web.tsx",
      "default": "./src/section-heading/SectionHeading.web.tsx"
    },
    "./segmented-control": {
      "react-native": "./src/segmented-control/SegmentedControl.native.tsx",
      "types": "./src/segmented-control/SegmentedControl.web.tsx",
      "default": "./src/segmented-control/SegmentedControl.web.tsx"
    },
    "./surface": {
      "react-native": "./src/surface/Surface.native.tsx",
      "types": "./src/surface/Surface.web.tsx",
      "default": "./src/surface/Surface.web.tsx"
    },
    "./button": {
      "react-native": "./src/button/Button.native.tsx",
      "types": "./src/button/Button.web.tsx",
      "default": "./src/button/Button.web.tsx"
    },
    "./input": {
      "react-native": "./src/input/Input.native.tsx",
      "types": "./src/input/Input.web.tsx",
      "default": "./src/input/Input.web.tsx"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@storybook/react-native": "^10.5.4",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19",
    "nativewind": "^4.2.6",
    "react": "^19",
    "react-native": "0.86.0",
    "react-native-svg": "^15.15.5",
    "typescript": "^5"
  },
  "dependencies": {
    "@supercalorie/core": "workspace:*"
  }
}
