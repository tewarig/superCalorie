{
  "name": "@supercalorie/ui",
  "version": "0.0.1",
  "private": true,
  "description": "superCalorie design system — shared tokens with platform-native components for React (web) and React Native (Expo).",
  "exports": {
    "./tokens": "./src/tokens.ts",
    "./button": {
      "react-native": "./src/button/Button.native.tsx",
      "types": "./src/button/Button.web.tsx",
      "default": "./src/button/Button.web.tsx"
    },
    "./input": {
      "react-native": "./src/input/Input.native.tsx",
      "types": "./src/input/Input.web.tsx",
      "default": "./src/input/Input.web.tsx"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19",
    "react": "^19",
    "react-native": "0.86.0",
    "typescript": "^5"
  }
}
