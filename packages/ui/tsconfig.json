{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    // The native components are rendered by jest-expo from apps/mobile.
    "types": ["jest"]
  },
  "include": ["src", "nativewind-env.d.ts", "theme.d.cts"]
}
