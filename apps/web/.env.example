# Signs session cookies and bearer tokens. REQUIRED in production —
# the app refuses to boot without it. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=

# Where the SQLite file lives. Defaults to apps/web/.data/supercalorie.db
# DATABASE_PATH=/absolute/path/to/supercalorie.db

# Where uploaded meal photos are written. Defaults to a "photos" directory
# beside the database, so one volume holds all state.
# PHOTO_DIR=/absolute/path/to/photos

# Food search falls back to USDA FoodData Central for generic whole foods.
# Without a key it uses DEMO_KEY, which is capped at ~30 requests an hour per
# IP — fine to try, not enough to actually use. A key is free and instant
# from https://fdc.nal.usda.gov/api-key-signup.html
# Open Food Facts (the other source) needs no key at all.
USDA_API_KEY=
