{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/require-node.mjs && NODE_OPTIONS=--experimental-sqlite next dev",
    "build": "node ../../scripts/require-node.mjs && NODE_OPTIONS=--experimental-sqlite next build",
    "start": "node ../../scripts/require-node.mjs && NODE_OPTIONS=--experimental-sqlite next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/require-node.mjs && NODE_OPTIONS=--experimental-sqlite vitest run --coverage",
    "test:watch": "node ../../scripts/require-node.mjs && NODE_OPTIONS=--experimental-sqlite vitest",
    "test:fast": "node ../../scripts/require-node.mjs && NODE_OPTIONS=--experimental-sqlite vitest run"
  },
  "dependencies": {
    "@supercalorie/core": "workspace:*",
    "@supercalorie/ui": "workspace:*",
    "next": "16.2.12",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
